{
    "name": "yu-laravel/schema-validator",
    "description": "Laravel Livewire tool that validates Schema.org structured data (JSON-LD and microdata) and rich result requirements.",
    "type": "library",
    "keywords": [
        "laravel",
        "livewire",
        "schema.org",
        "json-ld",
        "structured-data"
    ],
    "homepage": "https://github.com/yuriyakishin/laravel-schema-validator",
    "license": "MIT",
    "authors": [
        {
            "name": "Yuriy Akishin",
            "email": "yuriy.akishin@gmail.com",
            "homepage": "https://yu.net.ua"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "laravel/framework": "^13.0",
        "livewire/livewire": "^4.0",
        "yu-laravel/web-tools-core": "^1.0.2"
    },
    "autoload": {
        "psr-4": {
            "Yu\\SchemaValidator\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Yu\\SchemaValidator\\SchemaValidatorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
